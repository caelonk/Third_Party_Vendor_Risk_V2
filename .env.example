# Copy to .env and fill in. NEVER commit a real .env.

# Environment
ENV=development
DEBUG=false

# Datastores. In Docker Compose these are overridden to the service hostnames.
DATABASE_URL=postgresql+psycopg://vendor_risk:vendor_risk@localhost:5432/vendor_risk
REDIS_URL=redis://localhost:6379/0

# Auth — generate strong values per environment:
#   JWT_SECRET:          python -c "import secrets; print(secrets.token_urlsafe(48))"
#   APP_ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=change-me-generate-a-48-byte-urlsafe-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
COOKIE_SECURE=true
# COOKIE_DOMAIN=example.com

# Fernet key for encrypting per-org integration secrets at rest.
APP_ENCRYPTION_KEY=

# NVD system fallback API key (per-org keys are stored encrypted per tenant).
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# CORS (the SPA origin). JSON list.
CORS_ORIGINS=["http://localhost:5173"]

# SMTP defaults (per-org overrides live in org_integrations).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Exports run on a worker, are stored in object storage, and download through a
# short-lived signed link. Docker Compose sets these for its MinIO service.
#   local: files under EXPORT_LOCAL_DIR (API and worker must share it; dev only)
#   s3:    any S3-compatible store (AWS S3, MinIO, Cloudflare R2, ...)
EXPORT_STORAGE=local
EXPORT_LOCAL_DIR=var/exports
# No Redis/Celery (SQLite dev)? Render exports inside the API request instead.
EXPORT_RUN_INLINE=false
EXPORT_URL_TTL_SECONDS=300
EXPORT_RETENTION_HOURS=168
EXPORT_MAX_ACTIVE_PER_ORG=3
# S3 settings (EXPORT_STORAGE=s3). Leave the endpoints unset for AWS S3; leave
# the keys unset to use the default AWS credential chain (instance/task role).
S3_BUCKET=vendor-risk-exports
S3_REGION=us-east-1
S3_ENDPOINT_URL=
# The host browsers reach, if it differs from S3_ENDPOINT_URL (e.g. in Docker).
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CREATE_BUCKET=false
# Compose's MinIO root account (dev only; also used as the app's S3 key there).
# MINIO_ROOT_USER=vendorrisk
# MINIO_ROOT_PASSWORD=vendorrisk-dev-only

# Observability. LOG_FORMAT: auto (JSON in production, text otherwise) | json | text.
# Docker Compose defaults containers to json.
LOG_LEVEL=INFO
LOG_FORMAT=auto
# Sentry stays fully disabled unless a DSN is set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
APP_RELEASE=

# API processes (gunicorn): defaults to min(2*CPU+1, 8) workers, 150s timeout.
# WEB_CONCURRENCY=4
# GUNICORN_TIMEOUT=150

# Flower (compose profile "ops") refuses to start without this.
# FLOWER_BASIC_AUTH=admin:change-me
